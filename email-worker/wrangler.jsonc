{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helios-email-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  // Sin URL pública: solo corre por Cron Trigger.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
