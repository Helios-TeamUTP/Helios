# Variables del worker de correo HELIOS (envío por API HTTP de Brevo).
# Copia a .env para correr local, o ponlas en Railway (Variables del servicio).
# NUNCA commitear el .env real con valores.

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# API de Brevo: Settings > SMTP & API > API Keys > Generate a new API key
BREVO_API_KEY=xkeysib-tu_api_key_de_brevo

# Remitente VERIFICADO en Brevo (Senders). Si no defines SENDER_EMAIL,
# el worker usa GMAIL_USER como remitente (variable heredada de la
# version anterior via SMTP; opcional si ya defines SENDER_EMAIL).
SENDER_EMAIL=tucorreo@gmail.com
# GMAIL_USER=tucorreo@gmail.com
SENDER_NAME=HELIOS Citas

POLL_MS=8000
